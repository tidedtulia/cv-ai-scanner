{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many -t dev,serve --all",
    "affected:serve": "nx affected:serve",
    "affected:build": "nx affected:build",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "build": "nx run-many -t build --all",
    "test": "nx run-many -t test --all",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml --profile n8n down",
    "db:logs": "docker compose -f docker-compose.dev.yml logs -f db",
    "n8n:up": "sh n8n/setup/up.sh",
    "n8n:down": "docker compose -f docker-compose.dev.yml --profile n8n stop n8n",
    "n8n:logs": "docker compose -f docker-compose.dev.yml --profile n8n logs -f n8n-init n8n",
    "n8n:export": "sh n8n/setup/workflows.sh export",
    "n8n:import": "sh n8n/setup/workflows.sh import",
    "n8n:check": "sh n8n/setup/check.sh",
    "db:backup": "sh scripts/db/db-backup.sh",
    "db:upgrade": "sh scripts/db/db-upgrade.sh",
    "mcp:check": "node scripts/mcp/mcp-check.mjs",
    "mail:check": "node --env-file=.env scripts/mail/mail-check.mjs",
    "wf1:test": "node --test n8n/wf1/*.test.cjs n8n/setup/*.test.cjs",
    "wf1:check": "node scripts/wf1/wf1-check.mjs",
    "docker:check": "node scripts/deploy/docker-check.mjs",
    "bicep:check": "node scripts/deploy/bicep-check.mjs",
    "bicep:build": "az bicep build --file infra/azure/main.bicep --outfile tmp/azure/main.json"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/eslint": "22.6.5",
    "@nx/eslint-plugin": "22.6.5",
    "@nx/jest": "22.6.5",
    "@nx/js": "22.6.5",
    "@nx/nest": "^22.6.5",
    "@nx/next": "^22.6.5",
    "@nx/node": "22.6.5",
    "@nx/web": "22.6.5",
    "@nx/webpack": "22.6.5",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "~0.2.38",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.4.13",
    "babel-jest": "^30.0.2",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "^30.0.2",
    "jest-cucumber": "^4.5.0",
    "jest-environment-jsdom": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "nx": "22.6.5",
    "postcss": "8.4.38",
    "prettier": "^3.8.1",
