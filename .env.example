# Copy to `.env` at the repo root. Read by docker-compose.dev.yml, the backend and the Prisma CLI.
POSTGRES_USER=cv_scanner
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
# Change (e.g. 5433) if a local PostgreSQL already listens on 5432
POSTGRES_PORT=5432
POSTGRES_DB=cv_ai_scanner
DATABASE_URL=postgresql://cv_scanner:change_me@localhost:5432/cv_ai_scanner
PORT=3001

# First HR account created by `prisma db seed` (skipped if email/password are empty)
SEED_HR_NAME="HR Admin"
SEED_HR_EMAIL=hr@example.com
SEED_HR_PASSWORD=change_me

# Where CVs are stored: "local" (dev, no Google account needed) or "google-drive"
CV_STORAGE=local
# local: folder for CV files, relative to where the backend runs
CV_LOCAL_DIR=tmp/cv-uploads
# google-drive: OAuth of a regular Google account — see docs/features/submit-application-api/google-drive-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Printed by `cd packages/backend && npm run drive:auth`
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_CV_FOLDER_ID=

# Frontend (Next.js) — read when run through Nx (`npm run dev`), which loads this root .env
# Backend origin; the frontend rewrites /api/* to it (default http://localhost:3001)
BACKEND_URL=http://localhost:3001
# Optional: override the address shown on /privacy for data requests (default in src/config/site.ts)
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=

# n8n (Phase 2) — only needed for `npm run n8n:up`; see docs/features/n8n-docker-setup/n8n-setup.md
# These values are read by Docker Compose: wrap a value in single quotes if it contains #, $ or spaces.
# Fixed encryption key for n8n credentials (generate once: openssl rand -hex 32). Never change it after setup.
N8N_ENCRYPTION_KEY=
# Passwords of the DB roles created by n8n/setup/init-db.sh
# n8n: owner of database "n8n" (n8n's own data) · n8n_app: WF-1 · mcp_readonly: MCP tool (job data only)
N8N_DB_PASSWORD=
N8N_APP_DB_PASSWORD=
MCP_DB_PASSWORD=
# n8n owner login (password: 8-64 characters, at least 1 number and 1 uppercase letter)
N8N_OWNER_EMAIL=
N8N_OWNER_PASSWORD=
# Optional
N8N_OWNER_FIRST_NAME=
N8N_OWNER_LAST_NAME=
# Port on this machine (bound to 127.0.0.1 only), default 5678
N8N_HOST_PORT=
# Bearer token of the n8n MCP server (/mcp/cv-scanner), at least 32 characters: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Anthropic API key for WF-1 (n8n: Claude reads and scores the CVs). Also required by `npm run n8n:up`,
# like GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN above (n8n downloads the CVs with them).
ANTHROPIC_API_KEY=
