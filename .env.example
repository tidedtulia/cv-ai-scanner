# Copy to `.env` at the repo root. Read by docker-compose.dev.yml, the backend and the Prisma CLI.
POSTGRES_USER=cv_scanner
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
# Change (e.g. 5433) if a local PostgreSQL already listens on 5432
POSTGRES_PORT=5432
POSTGRES_DB=cv_ai_scanner
DATABASE_URL=postgresql://cv_scanner:change_me@localhost:5432/cv_ai_scanner
PORT=3001

# First HR account created by `prisma db seed` (skipped if email/password are empty)
SEED_HR_NAME="HR Admin"
SEED_HR_EMAIL=hr@example.com
SEED_HR_PASSWORD=change_me

# Where CVs are stored: "local" (dev, no Google account needed) or "google-drive"
CV_STORAGE=local
# local: folder for CV files, relative to where the backend runs
CV_LOCAL_DIR=tmp/cv-uploads
# google-drive: OAuth of a regular Google account — see docs/features/submit-application-api/google-drive-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Printed by `cd packages/backend && npm run drive:auth`
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_CV_FOLDER_ID=

# Frontend (Next.js) — read when run through Nx (`npm run dev`), which loads this root .env
# Backend origin; the frontend rewrites /api/* to it (default http://localhost:3001)
BACKEND_URL=http://localhost:3001
# Optional: override the address shown on /privacy for data requests (default in src/config/site.ts)
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
